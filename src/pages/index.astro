  <!-- Form Handling Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('creator-register-form');
      const alertBox = document.getElementById('form-alert');
      const submitBtn = document.getElementById('submit-btn');
      const btnText = document.getElementById('btn-text');
      const btnSpinner = document.getElementById('btn-spinner');
      const successView = document.getElementById('success-view');
      const confirmedEmail = document.getElementById('confirmed-email');
      const summaryName = document.getElementById('summary-name');
      const summaryPlatform = document.getElementById('summary-platform');
      const summaryHandle = document.getElementById('summary-handle');
      const resetBtn = document.getElementById('reset-form-btn');

      if (!form) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const formData = new FormData(form);
        const data = {
          fullName: formData.get('fullName'),
          email: formData.get('email'),
          whatsapp: formData.get('whatsapp'),
          platform: formData.get('platform'),
          handle: formData.get('handle'),
          niche: formData.get('niche'),
          timestamp: new Date().toISOString(),
        };

        // UI Loading State
        submitBtn.disabled = true;
        btnText.textContent = 'Memproses...';
        btnSpinner.classList.remove('hidden');
        alertBox.classList.add('hidden');

        try {
          // Send to Cloudflare Function / API
          try {
            await fetch('/api/register', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(data)
            }).catch(() => null);
          } catch (_) {}

          // Fallback persistent client-storage
          const existing = JSON.parse(localStorage.getItem('kn_registrations') || '[]');
          existing.push(data);
          localStorage.setItem('kn_registrations', JSON.stringify(existing));

          // Natural transition delay
          await new Promise(resolve => setTimeout(resolve, 600));

          // Switch to Success View
          form.classList.add('hidden');
          successView.classList.remove('hidden');

          if (confirmedEmail) confirmedEmail.textContent = data.email;
          if (summaryName) summaryName.textContent = data.fullName;
          if (summaryPlatform) summaryPlatform.textContent = data.platform;
          if (summaryHandle) summaryHandle.textContent = data.handle;

        } catch (err) {
          alertBox.className = 'mb-6 p-4 rounded-xl text-xs font-medium bg-rose-500/10 border border-rose-500/30 text-rose-300';
          alertBox.textContent = 'Terjadi kendala saat mengirim data. Silakan coba kembali.';
          alertBox.classList.remove('hidden');
        } finally {
          submitBtn.disabled = false;
          btnText.textContent = 'Kirim Pendaftaran & Dapatkan Akses';
          btnSpinner.classList.add('hidden');
        }
      });

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          form.reset();
          successView.classList.add('hidden');
          form.classList.remove('hidden');
        });
      }
    });
  </script>
