---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="KreatorNetwork — Jaringan & Komunitas Content Creator Terbesar di Indonesia"
  description="Kumpulan kreator konten aktif di Instagram, TikTok, YouTube, dan Forum. Akses circle diskusi eksklusif, tools AI, dan kolaborasi nyata."
>
  <!-- Background Grid Texture (Subtle & Editorial) -->
  <div class="fixed inset-0 pointer-events-none z-0 bg-grid-pattern opacity-40"></div>

  <div class="relative z-10 flex flex-col min-h-screen">
    <!-- Top Bar / Navbar -->
    <header class="sticky top-0 z-50 border-b border-white/10 bg-[#0b0c0e]/90 backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3.5 group">
          <div class="w-10 h-10 rounded-lg bg-zinc-900 border border-white/15 flex items-center justify-center text-white font-black text-sm tracking-widest group-hover:border-white/40 transition">
            KN
          </div>
          <div class="flex flex-col">
            <span class="font-extrabold text-lg tracking-tight text-white flex items-center gap-2">
              KreatorNetwork<span class="text-xs font-semibold px-2 py-0.5 rounded bg-zinc-800 text-zinc-300 border border-white/10">ID</span>
            </span>
            <span class="text-[10px] uppercase tracking-wider text-zinc-400 font-medium">Independent Creator Collective</span>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center gap-8 text-xs uppercase tracking-wider font-semibold text-zinc-400">
          <a href="#kreator" class="hover:text-white transition">Kreator Kami</a>
          <a href="#stats" class="hover:text-white transition">Statistik</a>
          <a href="#benefits" class="hover:text-white transition">Benefit</a>
          <a href="#faq" class="hover:text-white transition">FAQ</a>
        </nav>

        <!-- CTA Action -->
        <div class="flex items-center gap-3">
          <a
            href="#register"
            class="inline-flex items-center justify-center px-5 py-2.5 text-xs uppercase tracking-wider font-bold text-black bg-white hover:bg-zinc-200 rounded-lg transition active:scale-[0.98]"
          >
            Gabung Komunitas
          </a>
        </div>
      </div>
    </header>

    <main class="flex-grow">
      <!-- HERO SECTION -->
      <section class="relative pt-12 pb-20 md:pt-20 md:pb-28 border-b border-white/10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
            
            <!-- Left Column: Copywriting & Social Proof -->
            <div class="lg:col-span-7 flex flex-col items-start text-left">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900 border border-white/10 text-xs font-mono text-zinc-300 mb-6">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>OPEN REGISTRATION • BATCH 2026</span>
              </div>

              <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white leading-[1.08] mb-6">
                Jaringan Kreator Konten Aktif Terbesar di Indonesia.
              </h1>

              <p class="text-base sm:text-lg text-zinc-300 font-normal leading-relaxed max-w-xl mb-8">
                Bukan kursus dan bukan kelas teori. Ini adalah ekosistem para kreator dan digital storytellers yang setiap hari memproduksi konten di <span class="text-white font-semibold">Instagram</span>, <span class="text-white font-semibold">TikTok</span>, <span class="text-white font-semibold">YouTube</span>, hingga <span class="text-white font-semibold">Forum Komunitas</span>.
              </p>

              <!-- Social Proof: Real Nano Banana Creator Stack -->
              <div class="flex items-center gap-4 p-3 rounded-xl bg-zinc-900/80 border border-white/10 mb-8 w-full sm:w-auto">
                <div class="flex -space-x-3 overflow-hidden">
                  <img class="inline-block h-10 w-10 rounded-full ring-2 ring-[#0b0c0e] object-cover" src="/creators/avatar-indah.jpg" alt="Indah Permatasari" />
                  <img class="inline-block h-10 w-10 rounded-full ring-2 ring-[#0b0c0e] object-cover" src="/creators/avatar-aditya.jpg" alt="Aditya Permana" />
                  <img class="inline-block h-10 w-10 rounded-full ring-2 ring-[#0b0c0e] object-cover" src="/creators/avatar-clara.jpg" alt="Clara Stephanie" />
                  <img class="inline-block h-10 w-10 rounded-full ring-2 ring-[#0b0c0e] object-cover" src="/creators/avatar-kevin.jpg" alt="Kevin Tanuwidjaja" />
                  <img class="inline-block h-10 w-10 rounded-full ring-2 ring-[#0b0c0e] object-cover" src="/creators/avatar-budi.jpg" alt="Budi Santoso" />
                </div>
                <div class="flex flex-col text-xs">
                  <span class="font-bold text-white tracking-wide">350+ Content Creator</span>
                  <span class="text-zinc-400">Aktif posting & saling berkolaborasi</span>
                </div>
              </div>

              <!-- Action CTAs -->
              <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
                <a
                  href="#register"
                  class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 text-sm font-bold text-black bg-white hover:bg-zinc-200 rounded-lg transition active:scale-[0.98]"
                >
                  Daftar Menjadi Member — Gratis
                </a>
                <a
                  href="#kreator"
                  class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3.5 text-sm font-semibold text-zinc-300 hover:text-white bg-zinc-900 hover:bg-zinc-800 rounded-lg border border-white/10 transition"
                >
                  Lihat Profil Kreator ↓
                </a>
              </div>
            </div>

            <!-- Right Column: Authentic Editorial Visual Card -->
            <div class="lg:col-span-5 relative">
              <div class="editorial-card rounded-2xl overflow-hidden p-3 relative group">
                <!-- Main Featured Photo (Nano Banana Photo) -->
                <div class="relative aspect-[4/5] rounded-xl overflow-hidden bg-zinc-950">
                  <img
                    src="/creators/action-indah.jpg"
                    alt="Kreator Aktif Sedang Produksi Konten"
                    class="w-full h-full object-cover object-center group-hover:scale-[1.02] transition duration-500"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></div>

                  <!-- Overlay Meta Badge -->
                  <div class="absolute top-4 left-4 inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-black/70 backdrop-blur-md border border-white/15 text-[11px] font-mono text-white">
                    <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                    <span>STUDIO SESSION</span>
                  </div>

                  <!-- Bottom Caption -->
                  <div class="absolute bottom-4 left-4 right-4 text-left">
                    <span class="text-[11px] uppercase tracking-wider font-mono text-zinc-400">Featured Creator</span>
                    <h3 class="text-xl font-bold text-white mt-0.5">Indah Permatasari</h3>
                    <p class="text-xs text-zinc-300 mt-1">Lifestyle & Aesthetic Reels • 185k Followers di TikTok & Instagram</p>
                    <div class="mt-3 flex items-center gap-2">
                      <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/10 text-zinc-200 border border-white/10">1.8M Monthly Views</span>
                      <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/10 text-zinc-200 border border-white/10">Cross-Poster</span>
                    </div>
                  </div>
                </div>

                <!-- Floating Mini Side Card -->
                <div class="absolute -bottom-5 -left-5 bg-[#14171c] border border-white/15 rounded-xl p-3 shadow-2xl flex items-center gap-3 max-w-[260px] hidden sm:flex">
                  <img
                    src="/creators/avatar-aditya.jpg"
                    alt="Aditya Permana"
                    class="w-11 h-11 rounded-lg object-cover ring-1 ring-white/20"
                  />
                  <div class="flex flex-col text-left">
                    <span class="text-xs font-bold text-white">Aditya Permana</span>
                    <span class="text-[11px] text-zinc-400">Tech & Gadget Reviewer</span>
                    <span class="text-[10px] font-mono text-emerald-400 mt-0.5">● Baru saja merilis video</span>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- AGGREGATE STATS (EDITORIAL CLEAN NUMBERS) -->
      <section id="stats" class="py-16 bg-[#0f1115] border-b border-white/10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
            <div class="text-left border-l-2 border-white/20 pl-5">
              <span class="text-3xl sm:text-5xl font-black text-white tracking-tight">350+</span>
              <h4 class="text-sm font-bold text-zinc-200 mt-2">Kreator Aktif</h4>
              <p class="text-xs text-zinc-400 mt-1">Memproduksi minimal 3 konten per minggu</p>
            </div>
            <div class="text-left border-l-2 border-white/20 pl-5">
              <span class="text-3xl sm:text-5xl font-black text-white tracking-tight">12.5M+</span>
              <h4 class="text-sm font-bold text-zinc-200 mt-2">Organic Monthly Reach</h4>
              <p class="text-xs text-zinc-400 mt-1">Total impresi organik tanpa iklan berbayar</p>
            </div>
            <div class="text-left border-l-2 border-white/20 pl-5">
              <span class="text-3xl sm:text-5xl font-black text-white tracking-tight">850K+</span>
              <h4 class="text-sm font-bold text-zinc-200 mt-2">Interaksi Bulanan</h4>
              <p class="text-xs text-zinc-400 mt-1">Likes, komentar, save & share berkualitas</p>
            </div>
            <div class="text-left border-l-2 border-white/20 pl-5">
              <span class="text-3xl sm:text-5xl font-black text-white tracking-tight">14+</span>
              <h4 class="text-sm font-bold text-zinc-200 mt-2">Platform Media</h4>
              <p class="text-xs text-zinc-400 mt-1">IG, TikTok, YouTube, Threads, Forum & Web</p>
            </div>
          </div>
        </div>
      </section>

      <!-- CREATOR SPOTLIGHT (NANO BANANA PERSONAS IN ACTION) -->
      <section id="kreator" class="py-24 border-b border-white/10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex flex-col md:flex-row md:items-end justify-between mb-14">
            <div>
              <span class="text-xs font-mono text-zinc-400 uppercase tracking-widest">[ KOMUNITAS KREATIF ]</span>
              <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-2">
                Sebagian Member yang Aktif Berkarya
              </h2>
            </div>
            <p class="text-sm text-zinc-400 max-w-md mt-4 md:mt-0">
              Setiap member memiliki niche yang spesifik dan audiens setia. Kami saling mendukung interaksi dan menjaga kualitas karya.
            </p>
          </div>

          <!-- Creator Grid Cards -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            
            <!-- Creator 1 -->
            <div class="editorial-card rounded-xl p-5 text-left flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-4 mb-4">
                  <img src="/creators/avatar-indah.jpg" alt="Indah Permatasari" class="w-14 h-14 rounded-full object-cover border border-white/15" />
                  <div>
                    <h3 class="font-bold text-white text-base">Indah Permatasari</h3>
                    <p class="text-xs text-zinc-400">@indah.story • TikTok & Reels</p>
                    <span class="inline-block mt-1 text-[10px] font-mono px-2 py-0.5 rounded bg-zinc-800 text-zinc-300">Lifestyle & Travel</span>
                  </div>
                </div>
                <p class="text-xs text-zinc-300 leading-relaxed mb-4">
                  "Bergabung dengan KreatorNetwork membantu saya paham timing audio viral dan struktur video 3 detik pertama yang menahan retensi penonton."
                </p>
              </div>
              <div class="pt-3 border-t border-white/10 flex items-center justify-between text-[11px] font-mono text-zinc-400">
                <span>Reach: 240K/bln</span>
                <span class="text-emerald-400">Verified Member</span>
              </div>
            </div>

            <!-- Creator 2 -->
            <div class="editorial-card rounded-xl p-5 text-left flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-4 mb-4">
                  <img src="/creators/avatar-aditya.jpg" alt="Aditya Permana" class="w-14 h-14 rounded-full object-cover border border-white/15" />
                  <div>
                    <h3 class="font-bold text-white text-base">Aditya Permana</h3>
                    <p class="text-xs text-zinc-400">@adityatech.id • YouTube & Threads</p>
                    <span class="inline-block mt-1 text-[10px] font-mono px-2 py-0.5 rounded bg-zinc-800 text-zinc-300">Tech & Hardware</span>
                  </div>
                </div>
                <p class="text-xs text-zinc-300 leading-relaxed mb-4">
                  "Diskusi di grup komunitas sangat objektif. Kami saling membedah script review sebelum shooting, jadi konten selalu tajam dan dipercaya penonton."
                </p>
              </div>
              <div class="pt-3 border-t border-white/10 flex items-center justify-between text-[11px] font-mono text-zinc-400">
                <span>Reach: 480K/bln</span>
                <span class="text-emerald-400">Verified Member</span>
              </div>
            </div>

            <!-- Creator 3 -->
            <div class="editorial-card rounded-xl p-5 text-left flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-4 mb-4">
                  <img src="/creators/avatar-clara.jpg" alt="Clara Stephanie" class="w-14 h-14 rounded-full object-cover border border-white/15" />
                  <div>
                    <h3 class="font-bold text-white text-base">Clara Stephanie</h3>
                    <p class="text-xs text-zinc-400">@claraculinary • Instagram & TikTok</p>
                    <span class="inline-block mt-1 text-[10px] font-mono px-2 py-0.5 rounded bg-zinc-800 text-zinc-300">Culinary & Hospitality</span>
                  </div>
                </div>
                <p class="text-xs text-zinc-300 leading-relaxed mb-4">
                  "Akses template kalender konten dan prompt AI untuk riset angle makanan baru sangat menghemat waktu produksi saya setiap hari."
                </p>
              </div>
              <div class="pt-3 border-t border-white/10 flex items-center justify-between text-[11px] font-mono text-zinc-400">
                <span>Reach: 310K/bln</span>
                <span class="text-emerald-400">Verified Member</span>
              </div>
            </div>

            <!-- Creator 4 -->
            <div class="editorial-card rounded-xl p-5 text-left flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-4 mb-4">
                  <img src="/creators/avatar-kevin.jpg" alt="Kevin Tanuwidjaja" class="w-14 h-14 rounded-full object-cover border border-white/15" />
                  <div>
                    <h3 class="font-bold text-white text-base">Kevin Tanuwidjaja</h3>
                    <p class="text-xs text-zinc-400">@kevintanu • X Threads & Forum</p>
                    <span class="inline-block mt-1 text-[10px] font-mono px-2 py-0.5 rounded bg-zinc-800 text-zinc-300">Business & E-Commerce</span>
                  </div>
                </div>
                <p class="text-xs text-zinc-300 leading-relaxed mb-4">
                  "Menjangkau pembaca di Reddit dan forum butuh pendekatan otentik tanpa gaya marketing kaku. Di komunitas ini kami belajar membangun otoritas organik."
                </p>
              </div>
              <div class="pt-3 border-t border-white/10 flex items-center justify-between text-[11px] font-mono text-zinc-400">
                <span>Reach: 520K/bln</span>
                <span class="text-emerald-400">Verified Member</span>
              </div>
            </div>

            <!-- Creator 5 -->
            <div class="editorial-card rounded-xl p-5 text-left flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-4 mb-4">
                  <img src="/creators/avatar-budi.jpg" alt="Budi Santoso" class="w-14 h-14 rounded-full object-cover border border-white/15" />
                  <div>
                    <h3 class="font-bold text-white text-base">Budi Santoso</h3>
                    <p class="text-xs text-zinc-400">@budifinansial • YouTube & TikTok</p>
                    <span class="inline-block mt-1 text-[10px] font-mono px-2 py-0.5 rounded bg-zinc-800 text-zinc-300">Finance & Real Estate</span>
                  </div>
                </div>
                <p class="text-xs text-zinc-300 leading-relaxed mb-4">
                  "Edukasi finansial menuntut data yang valid dan visual yang mudah dipahami. Kolaborasi sesama kreator membuat distribusi materi kami jauh lebih luas."
                </p>
              </div>
              <div class="pt-3 border-t border-white/10 flex items-center justify-between text-[11px] font-mono text-zinc-400">
                <span>Reach: 750K/bln</span>
                <span class="text-emerald-400">Verified Member</span>
              </div>
            </div>

            <!-- Creator 6 -->
            <div class="editorial-card rounded-xl p-5 text-left flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-4 mb-4">
                  <img src="/creators/avatar-amanda.jpg" alt="Amanda Putri" class="w-14 h-14 rounded-full object-cover border border-white/15" />
                  <div>
                    <h3 class="font-bold text-white text-base">Amanda Putri</h3>
                    <p class="text-xs text-zinc-400">@amandaputri • Instagram & TikTok</p>
                    <span class="inline-block mt-1 text-[10px] font-mono px-2 py-0.5 rounded bg-zinc-800 text-zinc-300">Fashion & OOTD</span>
                  </div>
                </div>
                <p class="text-xs text-zinc-300 leading-relaxed mb-4">
                  "Menghubungkan audiens fashion dengan brand lokal membutuhkan standar visual tinggi. Jaringan ini memberi kami inspirasi dan partner kolaborasi nyata."
                </p>
              </div>
              <div class="pt-3 border-t border-white/10 flex items-center justify-between text-[11px] font-mono text-zinc-400">
                <span>Reach: 390K/bln</span>
                <span class="text-emerald-400">Verified Member</span>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- CANDID IN-ACTION PHOTO GRID -->
      <section class="py-20 bg-[#0e1014] border-b border-white/10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-left mb-10">
            <span class="text-xs font-mono text-zinc-400 uppercase tracking-widest">[ AKTIVITAS MEMBER ]</span>
            <h2 class="text-2xl sm:text-3xl font-bold text-white mt-2">
              Proses Produksi Tanpa Basa-Basi
            </h2>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="relative aspect-square rounded-xl overflow-hidden bg-zinc-900 border border-white/10 group">
              <img src="/creators/action-aditya.jpg" alt="Aditya Editing Konten" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
              <p class="absolute bottom-3 left-3 text-xs font-medium text-white">Shooting & Hardware Testing</p>
            </div>

            <div class="relative aspect-square rounded-xl overflow-hidden bg-zinc-900 border border-white/10 group">
              <img src="/creators/action-clara.jpg" alt="Clara Riset Konten" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
              <p class="absolute bottom-3 left-3 text-xs font-medium text-white">Riset Angle & Kalender Konten</p>
            </div>

            <div class="relative aspect-square rounded-xl overflow-hidden bg-zinc-900 border border-white/10 group">
              <img src="/creators/action-kevin.jpg" alt="Kevin Diskusi Komunitas" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
              <p class="absolute bottom-3 left-3 text-xs font-medium text-white">Review Tren Algoritma Mingguan</p>
            </div>

            <div class="relative aspect-square rounded-xl overflow-hidden bg-zinc-900 border border-white/10 group">
              <img src="/creators/action-dimas.jpg" alt="Dimas Riset SEO & Konten" class="w-full h-full object-cover object-top group-hover:scale-105 transition duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
              <p class="absolute bottom-3 left-3 text-xs font-medium text-white">Riset SEO & Skrip Edukasi</p>
            </div>
          </div>
        </div>
      </section>

      <!-- BENEFITS SECTION -->
      <section id="benefits" class="py-24 border-b border-white/10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-left max-w-2xl mb-16">
            <span class="text-xs font-mono text-zinc-400 uppercase tracking-widest">[ VALUE & BENEFIT ]</span>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-2 mb-4">
              Apa yang Kamu Dapatkan Saat Bergabung?
            </h2>
            <p class="text-zinc-400 text-sm sm:text-base leading-relaxed">
              Membuat konten sendirian itu melelahkan. Di KreatorNetwork, kita berbagi sistem, riset, dan jangkauan agar setiap kreator bisa tumbuh secara berkelanjutan.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Benefit 1 -->
            <div class="editorial-card rounded-2xl p-8 text-left">
              <div class="w-12 h-12 rounded-xl bg-zinc-800 border border-white/15 flex items-center justify-center text-white mb-6 font-bold text-lg">
                01
              </div>
              <h3 class="text-2xl font-bold text-white mb-3">
                Akses Exclusive Network & Group Diskusi
              </h3>
              <p class="text-zinc-300 text-sm leading-relaxed mb-6">
                Circle tertutup di Telegram & Discord bersama sesama kreator aktif. Diskusi update algoritma real-time, sharing tren audio, bedah performa postingan, dan kolaborasi cross-posting tanpa biaya.
              </p>
              <ul class="space-y-2.5 text-xs text-zinc-300 font-medium">
                <li class="flex items-center gap-2">
                  <span class="text-emerald-400 font-bold">✓</span>
                  Bebas spam & bebas penawaran sales liar
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-emerald-400 font-bold">✓</span>
                  Update algoritma TikTok & IG Reels setiap ada perubahan
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-emerald-400 font-bold">✓</span>
                  Peluang kolaborasi antar member dengan audiens yang relevan
                </li>
              </ul>
            </div>

            <!-- Benefit 2 -->
            <div class="editorial-card rounded-2xl p-8 text-left">
              <div class="w-12 h-12 rounded-xl bg-zinc-800 border border-white/15 flex items-center justify-center text-white mb-6 font-bold text-lg">
                02
              </div>
              <h3 class="text-2xl font-bold text-white mb-3">
                Resource, Tools AI & Template Konten Siap Pakai
              </h3>
              <p class="text-zinc-300 text-sm leading-relaxed mb-6">
